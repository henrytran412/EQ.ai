# Placeholders only. Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high: higher = more careful answers but slower replies (Claude took 2.5-4.8 s at high)
DIALOGUE_EFFORT=high
# comma-separated; the student web app dev server
ALLOWED_ORIGINS=http://localhost:5173
# Per-IP limits on paid calls, "hits/seconds": chat + handoff messages (Claude) and voice tokens (Cartesia).
# Everyone on one Wi-Fi (e.g. a venue) shares a public IP, so keep room for a room full of visitors.
CHAT_LIMIT=60/600
TOKEN_LIMIT=30/600
# Handoff checks (each open page asks every 2 s) and advisor messages.
HANDOFF_LIMIT=1800/600
# Advisor console (/staff) access code. Empty = the console stays closed. Use a long random code.
STAFF_CODE=
# optional: SQLite file for handoffs (default data/handoffs.db; rows are deleted after 24 hours)
HANDOFF_DB=
# one line added to distress replies, e.g. counseling center name + phone (fill from the official page)
CAMPUS_COUNSELING=
CARTESIA_API_KEY=
# optional: a Cartesia voice id (default "Maya", one of Cartesia's Emotive voices)
CARTESIA_VOICE_ID=
# optional: text-to-speech model (default sonic-3.5: its speed control was strongest in our test)
CARTESIA_TTS_MODEL=
# optional: speech-to-text model (default ink-2). Student audio goes to Cartesia's cloud: disclose it.
CARTESIA_STT_MODEL=
