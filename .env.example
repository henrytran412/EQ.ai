# Placeholders only. Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = shorter thinking, lower latency; raise only if answers get worse
CLAUDE_EFFORT=low
# comma-separated; the student web app dev server
ALLOWED_ORIGINS=http://localhost:5173
# one line added to distress replies, e.g. counseling center name + phone (fill from the official page)
CAMPUS_COUNSELING=
CARTESIA_API_KEY=
# Tone LLM served on Vultr (token-protected)
TONE_LLM_URL=
TONE_LLM_TOKEN=
# SpacetimeDB
SPACETIMEDB_HOST=
SPACETIMEDB_DB_NAME=
